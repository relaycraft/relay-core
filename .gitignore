# Generated by Cargo
target/

# Cargo.lock is not committed for libraries
# (but is committed for binaries like relay-core-cli)

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Mac
.AppleDouble
.LSOverride

# Logs
*.log

# Temp
tmp/
temp/

